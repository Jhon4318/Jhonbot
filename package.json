{
  "name": "bedrock-bot-console",
  "version": "0.3.5",
  "private": true,
  "description": "Minecraft Bedrock Edition 1.26.60 multi-bot desktop app with NetherNet HTTP identity diagnostics",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/runtime-guards.js && node --check src/auth-cache.js && node --check src/account-state.js && node --check src/destinations.js && node --check scripts/patch-bedrock-protocol.js && node --test",
    "postinstall": "node scripts/patch-bedrock-protocol.js",
    "prestart": "node scripts/patch-bedrock-protocol.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bedrock-protocol": "github:PrismarineJS/bedrock-protocol#b4160368b7e5272ccdd435f75459220c167fe4e4",
    "mineflayer": "https://github.com/Pix3lPirat3/mineflayer/archive/b24015aeeec68a5c94f54444f104f0e563595a30.tar.gz",
    "mineflayer-pathfinder": "2.4.5",
    "prismarine-auth": "3.1.1"
  },
  "overrides": {
    "prismarine-physics": "github:Pix3lPirat3/prismarine-physics#feat/bedrock-edition",
    "prismarine-chunk": "github:Pix3lPirat3/prismarine-chunk#feat/bedrock-1.26-chunks",
    "nethernet": "github:PrismarineJS/node-nethernet#c46db7da4f0e97ec04487648f5759e3f23ff8e9c",
    "bedrock-protocol": "github:PrismarineJS/bedrock-protocol#b4160368b7e5272ccdd435f75459220c167fe4e4"
  },
  "devDependencies": {
    "electron": "45.2.1"
  }
}
