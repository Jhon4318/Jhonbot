{
  "name": "bedrock-bot-console",
  "version": "0.6.2",
  "private": true,
  "description": "Minecraft Bedrock Edition 1.26.60 bot console with shared-account SubClient guests and Snappy compression support",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/bot-actions.js && node --check src/subclients.js && node --check test/snappy-compression.test.js && node --check src/renderer.js && node --check src/runtime-guards.js && node --check src/auth-cache.js && node --check src/account-state.js && node --check src/destinations.js && node --check scripts/patch-bedrock-protocol.js && node --check scripts/patch-nethernet-sdp.js && node --check scripts/validate-build-config.js && node --check test/subclients.test.js && node scripts/validate-build-config.js && node --test",
    "postinstall": "node scripts/patch-bedrock-protocol.js",
    "prestart": "node scripts/patch-bedrock-protocol.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "bedrock-protocol": "github:PrismarineJS/bedrock-protocol#b4160368b7e5272ccdd435f75459220c167fe4e4",
    "mineflayer": "https://github.com/Pix3lPirat3/mineflayer/archive/b24015aeeec68a5c94f54444f104f0e563595a30.tar.gz",
    "mineflayer-pathfinder": "2.4.5",
    "prismarine-auth": "3.1.1",
    "snappyjs": "0.7.0"
  },
  "overrides": {
    "@shinyoshiaki/binary-data": "npm:@seydx/binary-data@0.6.2",
    "prismarine-physics": "github:Pix3lPirat3/prismarine-physics#feat/bedrock-edition",
    "prismarine-chunk": "github:Pix3lPirat3/prismarine-chunk#feat/bedrock-1.26-chunks",
    "nethernet": "github:PrismarineJS/node-nethernet#c46db7da4f0e97ec04487648f5759e3f23ff8e9c",
    "bedrock-protocol": "github:PrismarineJS/bedrock-protocol#b4160368b7e5272ccdd435f75459220c167fe4e4"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.jhonbot.bedrockbotconsole",
    "productName": "Bedrock Bot Console",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "scripts/**/*",
      "package.json",
      "!**/.jest-cache/**"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Bedrock-Bot-Console-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "1041",
      "include": "build/installer.nsh"
    }
  }
}
